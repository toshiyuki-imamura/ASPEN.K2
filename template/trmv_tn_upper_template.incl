#pragma once


//=============================================================================

template < class TYPE >
__global__ void
API_private(TRMV_Upper_SYMV_post) (
                                   int const n,
                                   TYPE const  alpha,
                                   TYPE const  beta,
                                   _ReadOnly_ptr_(TYPE) z,
                                   _Writable_ptr_(TYPE) y,
                                   int const incy
                                   )
{
  int const row = threadIdx.x + blockIdx.x * blockDim.x;
  if ( row < n ) {
    TYPE * const yy = y + row * incy;
    TYPE Y_Reg = makeCONST<TYPE>(0);
    if ( beta != Y_Reg ) { Y_Reg = beta * yy[0]; }
    yy[0] = fma( alpha, z[row], Y_Reg );
  }
}

//=============================================================================

template < bool atomic_mode = true, class TYPE, int BLOCK_X, int BLOCK_Y >
__device__ __forceinline__ void
API_private(TRMV_UpperN_SYMV) (
                                   int const n,
                                   _ReadOnly_ptr_(TYPE) a,
                                   int const lda,
                                   _ReadOnly_ptr_(TYPE) x,
                                   int const incx,
                                   _Writable_ptr_(TYPE) z,
                                   int const id
                                   )
{
  int const zid = threadIdx.x;
  int const yid = INT_idiv(zid, BLOCK_X);
  int const xid = zid - yid * BLOCK_X;

  int const row0 = BLOCK_X * id;
  int const row  = row0 + xid;
  bool const mask = ( row < n && yid == 0 );

  TYPE S_Reg = makeCONST<TYPE>(0);

  if ( row < n ) {

    long const a_step = (long)lda*(long)BLOCK_Y;
    long const x_step = (long)incx*(long)BLOCK_Y;

    int const i0 = n-BLOCK_Y+yid;
    TYPE * ak = (TYPE *)a + (long)row + (long)(i0)*(long)lda;
    TYPE * xk = (TYPE *)x +             (long)(i0)*(long)incx;

    int constexpr LOOP_UNROLL = ( __isSPLITTABLE_FORMAT__ ? 16 : 4 );

    int i = i0;
    if constexpr ( LOOP_UNROLL > 1 ) {
#pragma unroll 1
      for ( ; i-(LOOP_UNROLL-1)*BLOCK_Y>=row; i-=LOOP_UNROLL*BLOCK_Y ) {
        TYPE A_Reg[LOOP_UNROLL], x_Reg[LOOP_UNROLL];
        for( int I=0; I<LOOP_UNROLL; I++ ) { A_Reg[I] = ak[0]; ak -= a_step; }
        for( int I=0; I<LOOP_UNROLL; I++ ) { x_Reg[I] = xk[0]; xk -= x_step; }
        for( int I=0; I<LOOP_UNROLL; I++ ) { S_Reg = fma( A_Reg[I], x_Reg[I], S_Reg ); }
      }
    }
#pragma unroll 1
    for ( ; i>=row; i-=BLOCK_Y ) {
      TYPE const A_Reg = ak[0]; ak -= a_step;
      TYPE const x_Reg = xk[0]; xk -= x_step;
      S_Reg = fma( A_Reg, x_Reg, S_Reg );
    }

  }

  if constexpr ( BLOCK_Y > 1 ) {
    __syncthreads();
    ((TYPE*)__shmem)[zid] = S_Reg;
    __syncthreads();
  }

  if ( mask ) {
    if constexpr ( BLOCK_Y > 1 ) {
#pragma unroll
      for ( int i=1; i<BLOCK_Y; i++ ) {
        S_Reg += ((TYPE*)__shmem)[zid+i*BLOCK_X];
      }
    }
    if constexpr ( atomic_mode ) {
      atomicRed_SPLIT( z + row, S_Reg );
    } else {
      z[row] = z[row] + S_Reg;
    }
  }
}

//=============================================================================

template < bool atomic_mode = true, class TYPE, int BLOCK_X, int BLOCK_Y >
__device__ __forceinline__ void
API_private(TRMV_UpperT_SYMV) (
                                   int const  n,
                                   _ReadOnly_ptr_(TYPE) a,
                                   int const  lda,
                                   _ReadOnly_ptr_(TYPE) x,
                                   int const  incx,
                                   _Writable_ptr_(TYPE) z,
                                   int const  id
                                   )
{
  int const zid = threadIdx.x;
  int const yid = INT_idiv(zid, BLOCK_X);
  int const xid = zid - yid * BLOCK_X;

  int const row0 = BLOCK_Y * id;
  int const row  = row0 + yid;
  bool const mask = ( row < n && xid == 0 );

  TYPE S_Reg = makeCONST<TYPE>(0);

  if ( row < n ) {

    long const x_step = BLOCK_X*(long)incx;
    long const a_step = BLOCK_X;

    int const i0 = xid;
    TYPE * ak = (TYPE *)a + (long)i0 + (long)lda*(long)row;
    TYPE * xk = (TYPE *)x + (long)i0*(long)incx;

    int constexpr LOOP_UNROLL = ( __isSPLITTABLE_FORMAT__ ? 16 : 4 );

    int i = i0;
    if constexpr ( LOOP_UNROLL > 1 ) {
#pragma unroll 1
      for ( ; i+(LOOP_UNROLL-1)*BLOCK_X<row; i+=LOOP_UNROLL*BLOCK_X ) {
        TYPE A_Reg[LOOP_UNROLL], x_Reg[LOOP_UNROLL];
        for( int I=0; I<LOOP_UNROLL; I++ ) { A_Reg[I] = ak[0]; ak += a_step; }
        for( int I=0; I<LOOP_UNROLL; I++ ) { x_Reg[I] = xk[0]; xk += x_step; }
        for( int I=0; I<LOOP_UNROLL; I++ ) { S_Reg = fma( Conj(A_Reg[I]), x_Reg[I], S_Reg ); }
      }
    }
#pragma unroll 1
    for ( ; i<row; i+=BLOCK_X ) {
      TYPE const A_Reg = ak[0]; ak += a_step;
      TYPE const x_Reg = xk[0]; xk += x_step;
      S_Reg = fma( Conj(A_Reg), x_Reg, S_Reg );
    }

  }

  if constexpr ( BLOCK_X > 1 ) {
    __syncthreads();
    ((TYPE*)__shmem)[zid] = S_Reg;
    __syncthreads();
  }

  if ( mask ) {
    if constexpr ( BLOCK_X > 1 ) {
#pragma unroll
      for ( int i=1; i<BLOCK_X; i++ ) {
        S_Reg += ((TYPE*)__shmem)[zid+i];
      }
    }
    if constexpr ( atomic_mode ) {
      atomicRed_SPLIT( z + row, S_Reg );
    } else {
      z[row] = z[row] + S_Reg;
    }
  }
}

//=============================================================================

template < int mode, class TYPE, int BLOCK_NX, int BLOCK_NY, int BLOCK_TX, int BLOCK_TY >
__global__ void
API_private(TRMV_Upper_SYMV) (
                              int const  n,
                              _ReadOnly_ptr_(TYPE) a,
                              int const  lda,
                              _ReadOnly_ptr_(TYPE) x,
                              int const  incx,
                              _Writable_ptr_(TYPE) z
                              )
{
  if constexpr ( mode == 1 ) {
    API_private(TRMV_UpperN_SYMV)
      < false, TYPE, BLOCK_NX, BLOCK_NY >
      ( n, a, lda, x, incx, z, blockIdx.x );
  }
  if constexpr ( mode == 2 ) {
    API_private(TRMV_UpperT_SYMV)
      < false, TYPE, BLOCK_TX, BLOCK_TY >
      ( n, a, lda, x, incx, z, blockIdx.x );
  }
  if constexpr ( mode == 3 ) {
  int const block_size = gridDim.x/2;
  if ( blockIdx.x < block_size ) {
    API_private(TRMV_UpperN_SYMV)
      < true, TYPE, BLOCK_NX, BLOCK_NY >
      ( n, a, lda, x, incx, z, blockIdx.x );
  } else {
    API_private(TRMV_UpperT_SYMV)
      < true, TYPE, BLOCK_TX, BLOCK_TY >
      ( n, a, lda, x, incx, z, blockIdx.x-block_size );
  }
  }
}

//=============================================================================

template < class TYPE, int BLOCK_NX, int BLOCK_NY, int BLOCK_TX, int BLOCK_TY >
__host__ void
API(TRMV_tn_upper_host) (
                         int const n,
                         TYPE const alpha,
                         TYPE const beta,
                         _ReadOnly_ptr_(TYPE) a,
                         int const lda,
                         _ReadOnly_ptr_(TYPE) x,
                         int const incx,
                         _Writable_ptr_(TYPE) y,
                         int const incy
                         )
{
  if ( n <= 0 ) return;

  cudaStream_t const stream  = API(get_Stream)();

  int  const t1 = BLOCK_TX * BLOCK_TY;
  int  const t2 = BLOCK_NX * BLOCK_NY;
  long const shmem_size = std::max( t1, t2 )*sizeof(TYPE);

  int const GX = (n-1)/BLOCK_NX+1;
  int const GY = (n-1)/BLOCK_TY+1;

  int const g0 = (n-1)/t1+1;
  int const g1 = std::max( GX, GY );
  int const g2 = __isSPLITTABLE_FORMAT__ ? 2*g1 : g1;

  TYPE * z = (TYPE *)API(get_device_WorkArea)();
  cudaMemsetAsync( z, 0, (size_t)n * sizeof(TYPE), stream );

  int smem_per_block_optin = 0;
  cudaDeviceGetAttribute(&smem_per_block_optin,
        cudaDevAttrMaxSharedMemoryPerBlockOptin, 0);

if constexpr ( __isSPLITTABLE_FORMAT__ ) {

  cudaFuncSetAttribute(
         API_private(TRMV_Upper_SYMV)
         < 3, TYPE, BLOCK_NX, BLOCK_NY, BLOCK_TX, BLOCK_TY >,
         cudaFuncAttributeMaxDynamicSharedMemorySize,
         (int)min((long)smem_per_block_optin,shmem_size*8) );
  API_private(TRMV_Upper_SYMV)
    < 3, TYPE, BLOCK_NX, BLOCK_NY, BLOCK_TX, BLOCK_TY >
    <<< g2, t1, shmem_size, stream >>>
    ( n, a, lda, x, incx, z );

} else {

  cudaFuncSetAttribute(
         API_private(TRMV_Upper_SYMV)
         < 1, TYPE, BLOCK_NX, BLOCK_NY, BLOCK_TX, BLOCK_TY >,
         cudaFuncAttributeMaxDynamicSharedMemorySize,
         (int)min((long)smem_per_block_optin,shmem_size*8) );
  API_private(TRMV_Upper_SYMV)
    < 1, TYPE, BLOCK_NX, BLOCK_NY, BLOCK_TX, BLOCK_TY >
    <<< g2, t1, shmem_size, stream >>>
    ( n, a, lda, x, incx, z );

  cudaFuncSetAttribute(
         API_private(TRMV_Upper_SYMV)
         < 2, TYPE, BLOCK_NX, BLOCK_NY, BLOCK_TX, BLOCK_TY >,
         cudaFuncAttributeMaxDynamicSharedMemorySize,
         (int)min((long)smem_per_block_optin,shmem_size*8) );
  API_private(TRMV_Upper_SYMV)
    < 2, TYPE, BLOCK_NX, BLOCK_NY, BLOCK_TX, BLOCK_TY >
    <<< g2, t1, shmem_size, stream >>>
    ( n, a, lda, x, incx, z );

}

  API_private(TRMV_Upper_SYMV_post)
    < TYPE >
    <<< g0, t1, shmem_size, stream >>>
    ( n, alpha, beta, z, y, incy );

}

//=============================================================================

