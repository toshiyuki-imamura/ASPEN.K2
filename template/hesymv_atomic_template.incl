//=============================================================================

template < int ARCH, class TYPE, int BLOCK_SIZE, int GY, int VX, int BASE, int MM >
__host__ void
API_private(HESYMV(shmem_info)) ( long & shmem_needed, long & shmem_size_per_block, int const BLOCK_MULTIPLICITY )
{
  shmem_needed = SHMEM_W_SIZE + 8*sizeof(int) + 6*sizeof(size_t);

  shmem_size_per_block = shmem_needed * BLOCK_MULTIPLICITY;
  cudaFuncSetAttribute(
                       API_private(HESYMV(kernel_main_do))
                       < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >,
                       cudaFuncAttributeMaxDynamicSharedMemorySize,
                       shmem_size_per_block );

  int numBlocks = 0;
  cudaOccupancyMaxActiveBlocksPerMultiprocessor( &numBlocks,
                                                 API_private(HESYMV(kernel_main_do))
                                                 < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >,
                                                 BLOCK_SIZE * VX,
                                                 shmem_needed );

  if ( Ceiling(shmem_needed, (long)SHMEM_UNIT_SIZE) * numBlocks <= SHMEM_wo_OPTIN_KB*1024 ) {

    shmem_size_per_block = shmem_needed;

  } else {

    int smem_per_sm = 0;
    int smem_per_block = 0;
    int smem_per_block_optin = 0;

    cudaDeviceGetAttribute(&smem_per_sm,
        cudaDevAttrMaxSharedMemoryPerMultiprocessor, 0);

    cudaDeviceGetAttribute(&smem_per_block_optin,
        cudaDevAttrMaxSharedMemoryPerBlockOptin, 0);

    smem_per_block = smem_per_block_optin;

    smem_per_block /= SHMEM_UNIT_SIZE;
    smem_per_block /= BLOCK_MULTIPLICITY;
    smem_per_block *= SHMEM_UNIT_SIZE;
    smem_per_block *= BLOCK_MULTIPLICITY;

    while ( 1 ) {

      cudaFuncSetAttribute(
                        API_private(HESYMV(kernel_main_do))
                        < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >,
                        cudaFuncAttributeMaxDynamicSharedMemorySize,
                        smem_per_block );

      cudaFuncAttributes attr;
      cudaFuncGetAttributes( &attr,
                         API_private(HESYMV(kernel_main_do))
                         < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM > );

      int const  shmem_capacity  = attr.maxDynamicSharedSizeBytes;
      int const  num_units       = shmem_capacity / SHMEM_UNIT_SIZE;
      int const  units_per_block = num_units / BLOCK_MULTIPLICITY;

      shmem_size_per_block = (long)units_per_block * SHMEM_UNIT_SIZE;

      int _____ numBlocks = 0;
      cudaOccupancyMaxActiveBlocksPerMultiprocessor( &numBlocks,
                                                   API_private(HESYMV(kernel_main_do))
                                                   < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >,
                                                   BLOCK_SIZE * VX,
                                                   shmem_size_per_block );

      if ( numBlocks >= BLOCK_MULTIPLICITY ) break;

      smem_per_block /= BLOCK_MULTIPLICITY;
      smem_per_block -= SHMEM_UNIT_SIZE;
      smem_per_block *= BLOCK_MULTIPLICITY;

      if ( smem_per_block <= 48*1024 ) {
        smem_per_block = 48*1024;
        cudaFuncSetAttribute(
                        API_private(HESYMV(kernel_main_do))
                        < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >,
                        cudaFuncAttributeMaxDynamicSharedMemorySize, smem_per_block );
        int const num_units       = smem_per_block / SHMEM_UNIT_SIZE;
        int const units_per_block = num_units / BLOCK_MULTIPLICITY;
        shmem_size_per_block = (long)units_per_block * SHMEM_UNIT_SIZE;
        break;
      }

    }

  }

}
		
#undef	THREADS
#undef	__SHMEM_W_SIZE__
#undef	SHMEM_W_SIZE

template < int ARCH, class TYPE >
__forceinline__ __host__ void *
API_private(HESYMV(alloc_work)) ( int const n, void * wk_ptr[], long const wk_len[], cudaStream_t const stream )
{
  int  const n_pat    = (1<<n);
  int  _____ opt_pat  = n_pat;
  long const WorkSize = API(get_device_WorkSize)();
  long _____ opt_size = 0;
  long _____ sum      = 0;
  int  const N        = abs( n );

  {
    // first : just confirm the full coverage
    sum = 0;
    for( int j=0; j<N; j++ ) {
      if ( wk_ptr[j] == NULL ) continue;
      sum += wk_len[j];
    }
  }

  if ( n < 0 ) {
    if ( sum <= WorkSize ) {
      return NULL;
    } else {
      return API(get_device_WorkArea)();
    }
  }

  if ( sum <= WorkSize ) {
    // not needed to calcurate alternative allocation
    opt_pat  = n_pat - 1;
    opt_size = sum;
  } else {
    for( int i=0; i<n_pat-1; i++ ) {
      sum = 0;
      for( int j=0; j<N; j++ ) {
        if ( wk_ptr[j] == NULL ) continue;
        if ( i & (1<<j) ) sum += wk_len[j];
      }
      if ( sum <= WorkSize ) {
        if ( sum > opt_size ) {
          opt_size = sum; opt_pat = i;
        }
      }
    }
  }
  long _____ max_size = sum;


  if ( opt_pat < n_pat ) {

    // second : allocation
    long _____ lGmemory  = std::max( max_size - opt_size, (long)0 );
    void _____ * Gmemory = NULL;
    if ( lGmemory > 0 ) {
      cudaError_t ret = cudaMallocAsync( &Gmemory, lGmemory, stream );
      if ( ret != cudaSuccess ) {
        API(shutdown)();
        exit ( 1 );
        return NULL;
      }
    }

    // third : assign to the allocated area
    void * addr_0 = API(get_device_WorkArea)();
    void * addr_1 = Gmemory;

    for( int i=0; i<N; i++ ) {
      if ( wk_ptr[i] == NULL ) { continue; }
      long _____ * ptr = (long *)wk_ptr[i];
      if ( wk_len[i] == 0 ) { *ptr = (long)NULL; continue; }
      if ( opt_pat & (1<<i) ) {
        // addr_0
        *ptr = (long)addr_0;
        addr_0 = (void *)((long)addr_0 + wk_len[i]);
      } else {
        // addr_1
        *ptr = (long)addr_1;
        addr_1 = (void *)((long)addr_1 + wk_len[i]);
      }
    }

    return Gmemory;
  }

  return NULL;
}

template < int ARCH, class TYPE >
__forceinline__ __host__ void
API_private(HESYMV(free_work)) ( _Writable_ptr_(void) Gmemory, cudaStream_t const stream )
{
  cudaFreeAsync ( Gmemory, stream );
}

template < int ARCH, class TYPE, int BLOCK_SIZE, int GY, int VX, int BASE, int MM >
__host__ void
API_private(HESYMV(host_main)) ( int  const n,
                                 _ReadOnly_ptr_(TYPE) a,
                                 int  const lda,
                                 _ReadOnly_ptr_(TYPE) x,
                                 int  const incx,
                                 _Writable_ptr_(TYPE) y,
                                 int  const incy,
                                 TYPE const alpha,
                                 TYPE const beta,
                                 int  const BLOCK_MULTIPLICITY
                                 )
{
  //
  // y = alpha * A[:::lda,:] * x[::incx] + beta * y[::incy]
  //

  cudaStream_t const stream  = API(get_Stream)();

  // define the thread and block shape info, but a 1D fashon
  int  const t1 = BLOCK_SIZE * VX;
  int  const GX = Ceil(n, BASE);


  // check the work-array status

  TYPE * dwork0  = NULL;
  TYPE * dwork1  = NULL;
  int * Tickets  = NULL;
  int * Ticketf  = NULL;

  int  const  nTickets   = KEEP_REPRO ? Ceil( n, BLOCK_SIZE ) : 0;
  int  const  nTicketf   = KEEP_REPRO ? GX : 0;
  int  const  ndwork0    = Ceiling( n, BLOCK_SIZE );
  int  const  ndwork1    = KEEP_REPRO ? Ceiling( n, BLOCK_SIZE ) : 0;

  long const siz         = 512/max(4,(int)sizeof(TYPE));
  long const ldwork0     = Ceiling( (long)sizeof(TYPE)*ndwork0, siz );
  long const ldwork1     = Ceiling( (long)sizeof(TYPE)*ndwork1, siz );
  long const lTickets    = Ceiling( (long)sizeof(int)*nTickets, siz );
  long const lTicketf    = Ceiling( (long)sizeof(int)*nTicketf, siz );

  int  _____ SGX       = 1;
  int  _____ SGY       = 1;
  void _____ * Gmemory = NULL;

  {
    long const WorkSize = API(get_device_WorkSize)();
    int  const numbers_MP = API(get_numbers_MP)();
#if KEEP_REPRO
    int const SMF = 3;
#  if USE_ATOMIC
    SGY = (GY <= 2*SMF) ? (GY+1)/2+(GY==2) : 1;
    int  SGY_ = ( GY > 2 * SGY ? 1 : 0 );
#  else
    SGY = (GY <= SMF ) ? GY : 1;
    int  SGY_ = ( GY > 1 * SGY ? 1 : 0 );
#  endif
    int  const num_entries = 4;
    long const dw = std::max( WorkSize - ldwork1*SGY - lTicketf*SGY_, (long)1 );
    long const dr = ldwork0 + lTickets;
#else
    SGY = 0;
    int  SGY_ = 0;
    int  const num_entries = 1;
    long const dw = WorkSize;
    long const dr = ldwork0;
#endif
    SGX = (int)std::min( Ceil( dw, dr ), (long)((GX+1)/2) );
    SGX = (int)std::min( SGX, (int)(numbers_MP+1)/2 );
    int SGX_ = SGX;
    while ( SGX > 1 )
    {
      void _____ * wk_ptr[10] = {
        &dwork0,        &Tickets,       &Ticketf,       &dwork1, };
      long _____   wk_len[10] = {
        ldwork0*SGX,    lTickets*SGX_,  lTicketf*SGY_,  ldwork1*SGY, };
      Gmemory = API_private(HESYMV(alloc_work))
        < ARCH, TYPE > ( -num_entries, wk_ptr, wk_len, stream );
      if ( Gmemory == NULL ) break;
      SGX--;
    }
    Gmemory = NULL;
    SGX  = std::max( SGX, 1 );
#if USE_ATOMIC
    SGX_ = ( GX > 2 * SGX ? SGX : 0 );
#else
    SGX_ = ( GX > 1 * SGX ? SGX : 0 );
#endif

#if KEEP_REPRO
#  if USE_ATOMIC
    if ( GY > 2*SMF )
#  else
    if ( GY > SMF )
#  endif
    {
      int SGY_old = SGY;
      int SGY____ = SGY_;
#  if USE_ATOMIC
      SGY = (GY+1)/2;
#  else
      SGY = GY;
#  endif
      SGY_ = 0;
      void _____ * wk_ptr[10] = {
        &dwork0,        &Tickets,       &Ticketf,       &dwork1, };
      long _____   wk_len[10] = {
        ldwork0*SGX,    lTickets*SGX_,  lTicketf*SGY_,  ldwork1*SGY, };
      Gmemory = API_private(HESYMV(alloc_work))
        < ARCH, TYPE > ( -num_entries, wk_ptr, wk_len, stream );
      if ( Gmemory != NULL ) { SGY = SGY_old; SGY_ = SGY____; }
    }

    if ( Gmemory != NULL )
    {
      int SGY_old = SGY;
      int SGY____ = SGY_;
    while ( SGY < GY ) {
      SGY++;
      SGY_ = SGY;
      void _____ * wk_ptr[10] = {
        &dwork0,        &Tickets,       &Ticketf,       &dwork1, };
      long _____   wk_len[10] = {
        ldwork0*SGX,    lTickets*SGX_,  lTicketf*SGY_,  ldwork1*SGY, };
      Gmemory = API_private(HESYMV(alloc_work))
        < ARCH, TYPE > ( -num_entries, wk_ptr, wk_len, stream );
      if ( Gmemory != NULL ) { SGY--; SGY_--; break; }
    }
      if ( SGY == SGY_old ) { SGY_ = SGY____; }
    }
#endif

#if USE_ATOMIC
    if ( SGX >= (GX+1)/2 ) { SGX = (GX+1)/2; SGX_ = 0; }
    if ( SGY >= (GY+1)/2 ) { SGY = (GY+1)/2; SGY_ = 0; }
#else
    if ( SGX >= GX ) { SGX = GX; SGX_ = 0; }
    if ( SGY >= GY ) { SGY = GY; SGY_ = 0; }
#endif

    {
      void _____ * wk_ptr[10] = {
        &dwork0,        &Tickets,       &Ticketf,       &dwork1, };
      long _____   wk_len[10] = {
        ldwork0*SGX,    lTickets*SGX_,  lTicketf*SGY_,  ldwork1*SGY, };
      Gmemory = API_private(HESYMV(alloc_work))
        < ARCH, TYPE > ( num_entries, wk_ptr, wk_len, stream );
    }

#if KEEP_REPRO
    if ( SGX_ == 0 ) Tickets = NULL;
    if ( SGY_ == 0 ) Ticketf = NULL;
#endif
  }

  int  const ld_dwork0   = ldwork0 / sizeof(TYPE);
#if KEEP_REPRO
  int  const ld_Tickets  = lTickets / sizeof(int);
  int  const ld_Ticketf  = lTicketf / sizeof(int);
#endif


  static long  shmem_size_per_block =  0;
  static long  shmem_needed         =  0;
  static int   runFirsttime = 1;

  if ( runFirsttime ) {
    API_private(HESYMV(shmem_info))
      < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >
      ( shmem_needed, shmem_size_per_block, BLOCK_MULTIPLICITY );
    shmem_needed = std::max( shmem_needed, shmem_size_per_block );
    runFirsttime = 0;
  }

  {
    dim3 const threads_P ( t1, 1 );
    dim3 const grid_P ( GX, 1 );
    long const shmem_size = sizeof(int) * SGX;

    ASPEN_KERNEL_INVOKE(
                        API_private(HESYMV(kernel_PRE_DO)),
                        < ARCH, TYPE >
                        <<< grid_P, threads_P, shmem_size, stream
                        >>> (
#if USE_STRUCT_PRE_DO
                             PRE_DO_Args<TYPE> {
#endif
                             SGX,
                             SGY,
#if KEEP_REPRO
                             Tickets,
                             ld_Tickets,
                             Ticketf,
                             ld_Ticketf,
#endif
                             dwork0,
                             ld_dwork0,
#if KEEP_REPRO
                             dwork1,
#endif
                             n,
                             nTickets
#if USE_STRUCT_PRE_DO
                             }
#endif
                             )
#undef	USE_STRUCT_PRE_DO
                        );
  }
  {
    dim3 const threads_P ( t1, 1 );
    dim3 const grid_P ( GX*GY, 1 );
    long const shmem_size = shmem_needed;

    ASPEN_KERNEL_INVOKE(
                        API_private(HESYMV(kernel_main_do)),
                        < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >
                        <<< grid_P, threads_P, shmem_size, stream
                        >>> (
#if USE_STRUCT_MAIN_DO
                             MAIN_DO_Args<TYPE> {
#endif
                             int2{ SGX, SGY },
                             a,
                             x,
                             lda,
                             n,
                             incx,
                             dwork0,
                             ld_dwork0,
#if KEEP_REPRO
                             dwork1,
#endif
#if KEEP_REPRO
                             Tickets,
                             ld_Tickets,
                             Ticketf,
                             ld_Ticketf,
#endif
                             GX
#if USE_STRUCT_MAIN_DO
                             }
#endif
                             )
#undef	USE_STRUCT_MAIN_DO
                        );
  }
  {
    dim3 const threads_P ( t1, 1 );
    dim3 const grid_P ( GX, 1 );
    long const shmem_size = 0;

    ASPEN_KERNEL_INVOKE(
                        API_private(HESYMV(kernel_POST_DO)),
                        < ARCH, TYPE >
                        <<< grid_P, threads_P, shmem_size, stream
                        >>> (
#if USE_STRUCT_POST_DO
                             POST_DO_Args<TYPE> {
#endif
                             SGX,
                             SGY,
                             alpha,
                             beta,
                             dwork0,
                             ld_dwork0,
#if KEEP_REPRO
                             dwork1,
#endif
                             y,
                             n,
                             incy
#if USE_STRUCT_POST_DO
                             }
#endif
                             )
                        );
#undef	USE_STRUCT_POST_DO
  }

  if ( Gmemory != NULL ) {
    API_private(HESYMV(free_work)) < ARCH, TYPE > ( Gmemory, stream );
  }

}

//=============================================================================

template < int ARCH, class TYPE, int BLOCK_SIZE, int GY, int VX, int BASE, int MM >
__host__ void
API_private(HESYMV(host_stat)) ( int const BLOCK_MULTIPLICITY )
{
  char const * RED_type_name[] = {
    "strong-ld-st",
    "atomic-repro",
    "atomic-norepro" };
  char const * YES_no[] = { "no", "YES" };

  printf( "\n" );
  printf( "%%\tW_RED_TYPE=\t%d [%s]\n", W_RED_TYPE, RED_type_name[W_RED_TYPE] );
  printf( "%%\tKEEP_REPRO=\t%s\n", YES_no[KEEP_REPRO] );
  printf( "%%\tUSE_ATOMIC=\t%s\n", YES_no[USE_ATOMIC] );

  printf( "\n" );
  printf( "%%\tUSE_STRICT_TICKET_CHECK=\t%s\n",  YES_no[USE_STRICT_TICKET_CHECK  ] );
  printf( "%%\tUSE_STRONG_CONTROL_ORDER=\t%s\n", YES_no[USE_STRONG_CONTROL_ORDER ] );
  printf( "%%\tUSE_STRONG_TICKET_ORDER=\t%s\n",  YES_no[USE_STRONG_TICKET_ORDER  ] );
  printf( "%%\tUSE_STRONG_ATOM_ORDER=\t\t%s\n",  YES_no[USE_STRONG_ATOM_ORDER    ] );
  printf( "%%\tUSE_STRONG_LDST_ORDER=\t\t%s\n",  YES_no[USE_STRONG_LDST_ORDER    ] );
  printf( "%%\tUSE_CONFIRM_LDST=\t\t%s\n",       YES_no[USE_CONFIRM_LDST         ] );
  printf( "%%\tUSE_WEAKER_ATOMIC=\t\t%s\n",      YES_no[USE_WEAKER_ATOMIC        ] );

  printf( "\n" );
  printf( "#define BLOCK_SIZE    %d\n", BLOCK_SIZE );
  printf( "#define GY            %d\n", GY );
  printf( "#define VX            %d\n", VX );
  printf( "#define UX            %d\n", BASE );
  printf( "#define MULTIPLICITY  %d\n", BLOCK_MULTIPLICITY );
  printf( "#define _M_           %d\n", MM );
  printf( "#define LOOP_TRAN     %d\n", LOOP_TRAN );
  printf( "\n" );

  {
    long shmem_size_per_block = 0;
    long shmem_needed         = 0;
    API_private(HESYMV(shmem_info))
      < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >
      ( shmem_needed, shmem_size_per_block, BLOCK_MULTIPLICITY );

    cudaFuncAttributes attr;
    ASPEN_KERNEL_INVOKE( cudaFuncGetAttributes,
                         ( &attr,
                           API_private(HESYMV(kernel_main_do))
                           < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM > ) );

    int const TB_by_Warp = MAX_WARP_PER_MP / Ceil(BLOCK_SIZE*VX, 32);
    int const TB_by_Regs = ((MAX_REGS_PER_BLOCK / Ceiling( attr.numRegs*32, REGIS_UNIT_SIZE ))/WARP_ALLOC_UNIT)*WARP_ALLOC_UNIT / Ceil(BLOCK_SIZE*VX,32);
    int const TB_by_Smem = attr.maxDynamicSharedSizeBytes / shmem_needed;

    int const TB_ALL = std::min(TB_by_Warp,std::min(TB_by_Regs,TB_by_Smem));

    printf( "#-> %6d warps per threadBlock / %d -> [%d]\n",
            Ceil(BLOCK_SIZE*VX, 32),
            MAX_WARP_PER_MP,
            TB_by_Warp );
    printf( "#-> %6d registers per thread / %d / %d -> [%d]\n",
            attr.numRegs,
            Ceiling( attr.numRegs*32, REGIS_UNIT_SIZE )*Ceil(BLOCK_SIZE*VX,32),
            MAX_REGS_PER_BLOCK,
            TB_by_Regs );
    printf( "#-> %6d bytes per threadBlock (needed) / %5d -> [%d]\n",
            (int)shmem_needed,
            attr.maxDynamicSharedSizeBytes,
            TB_by_Smem );

    int const TB_by_Smem_ = TB_by_Smem * ( (TB_by_Smem < TB_by_Warp) && (TB_by_Smem < TB_by_Regs) ? 2 : 1 );

    printf( "#-> %6d bytes per threadBlock (opt-in) / %5d -> [%d]\n",
            (int)shmem_size_per_block,
            attr.maxDynamicSharedSizeBytes,
            TB_by_Smem_ );

    int numBlocks = 0;
    cudaOccupancyMaxActiveBlocksPerMultiprocessor( &numBlocks,
                                                   API_private(HESYMV(kernel_main_do))
                                                   < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >,
                                                   BLOCK_SIZE * VX,
                                                   shmem_size_per_block );

    printf( "#-> %6d maximum threadBlocks per SM %s\n", numBlocks,
            (numBlocks == BLOCK_MULTIPLICITY ? "" : "(*adjusted)" ) );

    long const activ = (BLOCK_SIZE*VX/32)*numBlocks;
    double const occup = 100.0*activ/MAX_WARP_PER_MP;

    printf( "#-> %6.2lf maximum occupancy [percent] : %d / %d\n",
            occup,
            (BLOCK_SIZE*VX/32)*numBlocks,
            MAX_WARP_PER_MP );
  }

  printf( "\n" );
  return;
}

#undef	_GY_
#undef	W_RED_TYPE

#undef	KEEP_REPRO
#undef	USE_ATOMIC
#undef	LOOP_TRAN

#undef	USE_STRICT_TICKET_CHECK	
#undef	USE_STRONG_CONTROL_ORDER
#undef	USE_STRONG_TICKET_ORDER	
#undef	USE_STRONG_ATOM_ORDER
#undef	USE_STRONG_LDST_ORDER
#undef	USE_CONFIRM_LDST
#undef	USE_WEAKER_ATOMIC

//=============================================================================

template < int ARCH, class TYPE, int BLOCK_SIZE, int GY, int VX, int BASE, int BLOCK_MULTIPLICITY, int MM >
__host__ int
API_private(HESYMV(ATOMIC__host)) ( int  const n,
                                    _ReadOnly_ptr_(TYPE) a,
                                    int const lda,
                                    _ReadOnly_ptr_(TYPE) x,
                                    int const incx,
                                    _Writable_ptr_(TYPE) y,
                                    int const incy,
                                    TYPE const alpha,
                                    TYPE const beta
                                    )
{
  if ( n == 0 ) {
    API_private(HESYMV(host_stat))
      < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >
      ( BLOCK_MULTIPLICITY );
    return 1;
  }

  API_private(HESYMV(host_main))
    < ARCH, TYPE, BLOCK_SIZE, GY, VX, BASE, MM >
    ( n, a, lda, x, incx, y, incy, alpha, beta, BLOCK_MULTIPLICITY );

  return 1;
}

