#pragma once

//=============================================================================
//=============================================================================

#  if ASPEN_UPLO==UPPER
#    define	HESYMV(x,...)	HESYMVu_##x
#    define	DELTAX(x,...)	(+(x))
#    define	isUPPER		( true )
#    define	isLOWER		( false )
#  else
#    define	HESYMV(x,...)	HESYMVl_##x
#    define	DELTAX(x,...)	(-(x))
#    define	isUPPER		( false )
#    define	isLOWER		( true )
#  endif


#define	_GY_			(4)
#define W_RED_TYPE		(1)


#if !defined(W_RED_TYPE)
#  define W_RED_TYPE		(1)
#endif
#if __isINT__
#  undef	W_RED_TYPE
#  define	W_RED_TYPE	(2)
#endif
#if __isCOMPOUND_FORMAT__ || _is128BIT_FORMAT__ || _is256BIT_FORMAT__
#  undef	W_RED_TYPE
#  define	W_RED_TYPE	(0)
#endif

#if W_RED_TYPE==0
#  define	KEEP_REPRO	(1)
#  define	USE_ATOMIC	(0)
#  define	LOOP_TRAN	(5)
#endif
#if W_RED_TYPE==1
#  define	KEEP_REPRO	(1)
#  define	USE_ATOMIC	(1)
#  define	LOOP_TRAN	(0)
#endif
#if W_RED_TYPE==2
#  define	KEEP_REPRO	(0)
#  define	USE_ATOMIC	(1)
#  define	LOOP_TRAN	(5)
#endif

#define	USE_STRICT_TICKET_CHECK		(0)
#define	USE_STRONG_CONTROL_ORDER	(0)
#define	USE_STRONG_TICKET_ORDER		(0)
#define	USE_STRONG_ATOM_ORDER		(0)
#define	USE_STRONG_LDST_ORDER		(0)
#define	USE_CONFIRM_LDST		(0)
#define	USE_WEAKER_ATOMIC		(0)

#if KEEP_REPRO
#  if USE_ATOMIC
#    undef	USE_STRONG_ATOM_ORDER
#    define	USE_STRONG_ATOM_ORDER	(1)
#  else
#    undef	USE_STRONG_TICKET_ORDER
#    define	USE_STRONG_TICKET_ORDER	(1)
#    undef	USE_STRONG_LDST_ORDER
#    define	USE_STRONG_LDST_ORDER	(1)
#  endif
#else
#  if USE_ATOMIC
#    undef	USE_WEAKER_ATOMIC
#    define	USE_WEAKER_ATOMIC	(1)
#  endif
#endif

#if defined(GY2D)
#  undef GY2D
#endif
#if W_RED_TYPE==0
#  define	GY2D	2
#endif
#if W_RED_TYPE==1
#  define	GY2D	4
#endif
#if W_RED_TYPE==2
#  define	GY2D	10
#endif

