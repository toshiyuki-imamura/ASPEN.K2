#if !defined(CURRENT_GPU)
#  include "../tuning/CURRENT_GPU"
#endif
#if !defined(GPU_ARCH)
#  define GPU_ARCH	CURRENT_GPU
#endif

#include "@TYPE..h"
#include "aspen_devel.h"

#if ( '@p1.'!='h' && '@p1.'!='k' ) || ASPEN_HALF_ENABLED
#  include "@p.@kernel._@luop.-X_template.cu"
#endif

extern "C" void
API(@P.@KERNEL.@lu.) ( int const blk,
              int const n, scalar_t const * a, int const lda,
              scalar_t const * x, int const incx,
              scalar_t * y, int const incy,
              scalar_t const alpha, scalar_t const beta )
{

  // y = alpha * A * x + beta * y
  // y(1:n1)
  // x(1:n2)

#if ( '@p1.'!='h' && '@p1.'!='k' ) || ASPEN_HALF_ENABLED

  int Ver = API(get_device_CC) ( );

  if ( CURRENT_GPU == Ver ) {
    API_private(@P.@KERNEL.@lu._STUB) ( blk,
                               n, a, lda, x, incx, y, incy, alpha, beta );
  } else {
    perror( "unmatched GPU generation" ); /* unmatched */
  }

#endif

}

#if ( '@p1.'!='h' && '@p1.'!='k' ) || ASPEN_HALF_ENABLED
#  include "aspen_devel_postdef.h"
#  include "../template/trmv_n_@luop._for_symv_template.incl"
#  include "../template/trmv_t_@luop._for_symv_template.incl"
#endif

extern "C"
void
@p.@kernel._@luop._small (
              int const n,
              scalar_t const alpha,
              scalar_t const * a, int const lda,
              scalar_t const * x, int const incx,
              scalar_t const beta,
              _____ scalar_t * y, int const incy
        )
{
#if ( '@p1.'!='h' && '@p1.'!='k' ) || ASPEN_HALF_ENABLED

  if ( n <= 0 ) return;

#  if defined(SMALL_NX)
#    undef      SMALL_NX
#  endif
#  if defined(SMALL_NY)
#    undef      SMALL_NY
#  endif
#  if CURRENT_GPU==800
#    define     SMALL_NX        16
#    define     SMALL_NY        32
#  else
#    if ( '@p1.'=='d' || '@p1.'=='z' )
#    define     SMALL_NX        32
#    define     SMALL_NY        24
#    else
#      if ( '@p1.'=='w' || '@p1.'=='u' || ( '@p1.'=='i' && @SIZEOF.>=8 ) )
#    define     SMALL_NX        8
#    define     SMALL_NY        40
#      endif
#    endif
#  endif
#  if !defined(SMALL_NX)
#    define     SMALL_NX        16
#  endif
#  if !defined(SMALL_NY)
#    define     SMALL_NY        40
#  endif

#  if defined(SMALL_TX)
#    undef      SMALL_TX
#  endif
#  if defined(SMALL_TY)
#    undef      SMALL_TY
#  endif
#  if CURRENT_GPU==800
#    define     SMALL_TX        128
#    define     SMALL_TY        1
#  else
#  if ( '@p1.'=='z' || '@p1.'=='w' || '@p1.'=='u' )
#    define     SMALL_TX        16
#    define     SMALL_TY        6
#  endif
#  endif
#  if !defined(SMALL_TX)
#    define     SMALL_TX        32
#  endif
#  if !defined(SMALL_TY)
#    define     SMALL_TY        4
#  endif

  API(TRMV_n_@luop._for_SYMV_host)
    < scalar_t, SMALL_NX, SMALL_NY >
    ( n, alpha, beta, a, lda, x, incx, y, incy );

  API(TRMV_t_@luop._for_SYMV_host)
    < scalar_t, SMALL_TX, SMALL_TY >
    ( n, alpha, beta, a, lda, x, incx, y, incy );

#endif
}

